# Framework identity — edit this one file to rebrand a fork.
# Lives in templates/ so it travels through the <prefix>-templates junction:
# scaffold.sh reads it at runtime, install.sh/install.ps1 read it at install time.
# One thing a config can't do: rename the command file itself. After editing,
# also: git mv commands/chip-init.md commands/<your-prefix>-init.md
FRAMEWORK_NAME=chip-claude
FRAMEWORK_PREFIX=chip
